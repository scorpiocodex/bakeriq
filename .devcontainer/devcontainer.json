{
  // BakeriQ dev container — sidecar to the docker-compose stack.
  //
  // What this does:
  //   - Spins up a Python 3.11 dev container (matches backend/Dockerfile)
  //   - Installs Node 20 inside it (matches frontend/Dockerfile)
  //   - Joins the docker-compose network so api/db/redis are reachable by
  //     hostname (e.g. db:5432, redis:6379, api:8000) from this container
  //   - Mounts the repo at /workspaces/bakeriq
  //   - Configures Python (Pylance/Ruff), JS/TS (ESLint/Prettier), Tailwind,
  //     and Docker tooling
  //
  // What it does NOT do:
  //   - It does NOT replace your existing `docker compose up` workflow.
  //     You still run the stack normally; this container is a separate
  //     development environment that connects to it.
  //   - It does NOT run the api or frontend processes. The api container
  //     runs uvicorn, the frontend container runs vite — both unchanged.
  //
  // First-time setup:
  //   1. Install the "Dev Containers" extension in VS Code
  //   2. Make sure your stack is running: `docker compose up -d`
  //   3. Cmd/Ctrl+Shift+P → "Dev Containers: Reopen in Container"
  //   4. First build takes ~3-5 min; subsequent opens are instant
  "name": "BakeriQ Dev",

  // Use a Microsoft-maintained Python 3.11 image — matches your backend
  // Dockerfile's `python:3.11-slim` base
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  // Add Node.js (matches frontend container's Node 20) and Docker CLI
  // (so we can run `docker compose` commands from inside the dev container).
  // Features are official Microsoft-maintained add-ons — install reliably.
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"],

  // Join the docker-compose network so this container can reach the
  // running api/db/redis services by their service names. Adjust the
  // network name if your `docker compose ps` shows a different one
  // (typically `<project-folder>_default` — for you, `bakeriq_default`)
  "runArgs": ["--network=bakeriq_default"],

  // Mount the repo. The default mount is fine, but we set workspaceFolder
  // explicitly for clarity in terminal paths
  "workspaceFolder": "/workspaces/bakeriq",

  // Forward the ports your stack uses, so you can open them from VS Code's
  // Ports panel and ctrl-click URLs in terminal output
  "forwardPorts": [8000, 5173, 5432, 5433, 6379],
  "portsAttributes": {
    "8000": { "label": "API (FastAPI)" },
    "5173": { "label": "Frontend (Vite)" },
    "5432": { "label": "Postgres (dev)" },
    "5433": { "label": "Postgres (test)" },
    "6379": { "label": "Redis" }
  },

  // Install Python deps inside the dev container after build so Pylance
  // has the real types (fastapi, sqlalchemy, etc.) available for IntelliSense.
  // This is independent of the api container — that one has its own venv;
  // this is just for editor tooling.
  "postCreateCommand": "pip install --user -r backend/requirements.txt && cd frontend && npm ci",

  "customizations": {
    "vscode": {
      "extensions": [
        // Python stack
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-python.black-formatter",

        // JS/TS/React
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",

        // Docker / container tooling
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",

        // Database
        "ms-ossdata.vscode-pgsql",

        // Quality of life
        "eamodio.gitlens",
        "PKief.material-icon-theme",
        "arcticicestudio.nord-visual-studio-code",
        "christian-kohler.path-intellisense",
        "streetsidesoftware.code-spell-checker",

        // REST testing for the API
        "humao.rest-client"
      ],
      "settings": {
        // === Python — point at the dev container's interpreter,
        // NOT the .venv path from user settings (which doesn't exist here)
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.languageServer": "Pylance",
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.autoSearchPaths": true,
        "python.analysis.diagnosticMode": "workspace",
        "python.analysis.extraPaths": ["backend"],
        "python.analysis.inlayHints.variableTypes": true,
        "python.analysis.inlayHints.functionReturnTypes": true,
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.cwd": "${workspaceFolder}/backend",
        "python.testing.pytestArgs": ["tests"],

        // === Editor — matches your user settings
        "editor.fontFamily": "'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, 'Courier New', monospace",
        "editor.fontLigatures": true,
        "editor.fontSize": 14,
        "editor.lineHeight": 1.6,
        "editor.formatOnSave": true,
        "editor.formatOnPaste": false,
        "editor.linkedEditing": true,
        "editor.minimap.enabled": false,
        "editor.bracketPairColorization.enabled": false,
        "editor.guides.bracketPairs": false,
        "editor.renderWhitespace": "selection",
        "editor.rulers": [88, 100],
        "editor.wordWrap": "on",
        "editor.smoothScrolling": true,
        "editor.cursorBlinking": "smooth",
        "editor.cursorSmoothCaretAnimation": "on",

        "files.autoSave": "onFocusChange",
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.exclude": {
          "**/.git": true,
          "**/.DS_Store": true,
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.venv": true,
          "**/node_modules": false
        },
        "files.associations": {
          "docker-compose*.yml": "dockercompose",
          "**/requirements{/**,*}.{txt,in}": "pip-requirements"
        },

        // === Per-language formatters
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[dockerfile]": { "editor.defaultFormatter": "ms-azuretools.vscode-containers" },
        "[dockercompose]": { "editor.defaultFormatter": "ms-azuretools.vscode-containers" },

        // === ESLint / Prettier
        "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],
        "eslint.run": "onType",
        "eslint.workingDirectories": [{ "directory": "./frontend", "changeProcessCWD": true }],
        "prettier.singleQuote": true,
        "prettier.trailingComma": "all",
        "prettier.printWidth": 100,

        // === Tailwind — points at the frontend's config
        "tailwindCSS.experimental.configFile": "frontend/tailwind.config.js",

        // === Emmet
        "emmet.includeLanguages": {
          "javascript": "javascriptreact"
        },

        // === Workbench
        "workbench.startupEditor": "none",
        "workbench.editor.enablePreview": false,
        "workbench.sideBar.location": "left",
        "workbench.tree.indent": 16,
        "workbench.colorTheme": "Nord Deep",
        "workbench.iconTheme": "material-icon-theme",

        // === Explorer
        "explorer.compactFolders": false,
        "explorer.confirmDragAndDrop": false,
        "explorer.confirmDelete": false,

        // === Terminal — uses bash inside the container
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.fontSize": 11,
        "terminal.integrated.smoothScrolling": true,
        "terminal.integrated.cursorBlinking": true,

        // === Git
        "git.autofetch": true,
        "git.confirmSync": false,
        "git.enableSmartCommit": true,
        "gitlens.codeLens.enabled": true,
        "gitlens.hovers.currentLine.over": "line"
      }
    }
  },

  // Run as a non-root user inside the dev container. The python:3.11-bookworm
  // devcontainer image ships with a `vscode` user (uid 1000) — matches the
  // UID your Dockerfiles use for the `app` user, so file permissions on the
  // bind-mounted repo stay consistent.
  "remoteUser": "vscode"
}
