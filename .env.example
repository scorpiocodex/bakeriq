# === Application ===
PROJECT_NAME=BakeriQ
ENVIRONMENT=development
DEBUG=true

# === Security ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-output-of-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === Ollama (local LLM) ===
# Ollama runs natively on the host (not in Docker — Intel Arc accel
# is more reliable native, and we keep the worker container slim).
# How a container reaches the host depends on the platform:
#   Linux (Docker Engine):           http://172.17.0.1:11434
#       The Docker bridge gateway. Ollama must also listen on 0.0.0.0
#       (docs/SETUP.md, step 2b).
#   Windows / macOS (Docker Desktop): http://host.docker.internal:11434
#       Tested on Windows 11 with Docker Desktop: Ollama's default
#       127.0.0.1 binding is enough, and 172.17.0.1 does NOT work there
#       (connection refused). macOS is untested.
# Changing this needs the containers recreated:
#   docker compose up -d --force-recreate api worker
OLLAMA_BASE_URL=http://172.17.0.1:11434

# Pinned model. Llama 3.2 3B Instruct, Q4_K_M quantization (Ollama
# default). ~2GB on disk, ~4GB resident. ~3-5s/inference on Ultra 5
# 125H CPU. Native structured-JSON support via Ollama's `format`
# parameter. To switch models later (e.g. Qwen 2.5 3B), `ollama pull`
# the new one and change this string.
OLLAMA_MODEL=llama3.2:3b

# === Celery ===
# Redis databases 1 and 2 — separate from cache (DB 0) so a celery
# flush doesn't nuke conversation state.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Twilio — get from https://console.twilio.com (Account SID + Auth Token)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public URL Twilio uses to reach this app. In dev, this is your ngrok URL.
# The template bootstrap refuses to run while this still says localhost.
# After changing it, recreate the containers:
#   docker compose up -d --force-recreate api worker
PUBLIC_BASE_URL=http://localhost:8000

# Base URL for the links the bot sends in plain-text messages. Links are
# built as <base>/<kind>/<token>, and the customer app is served under /web,
# so the base must end in /web. In dev through ngrok that is
# https://<your-ngrok-host>/web
CUSTOMER_WEB_BASE_URL=http://localhost:5174/web

# Your own WhatsApp number in international format (+91XXXXXXXXXX). New
# customer registrations are announced here. Leave it commented out and the
# alert is logged and skipped instead.
# OWNER_WHATSAPP_PHONE=+91XXXXXXXXXX

# Not set here: the nine CONTENT_SID_* values. The template bootstrap
# (make templates-refresh) writes them to a separate, git-ignored file,
# backend/.env, which the app reads at start-up.

# Customer web app dev — points at the api in dev.
# In production this isn't used (frontend-customer build assumes
# same-origin /api/* routing through the reverse proxy).
VITE_API_BASE_URL=http://localhost:8000

# === Database ===
POSTGRES_USER=bakeriq
POSTGRES_PASSWORD=bakeriq_dev_password
POSTGRES_DB=bakeriq
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === CORS ===
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# === Docker user mapping (WSL fix) ===
UID=1000
GID=1000


# === Business details ===
# Printed on invoice headers. Lives here because there's no settings
# table yet — a future Settings → Bakery info section will replace it.
BUSINESS_NAME=BakeriQ
BUSINESS_ADDRESS_LINE_1=
BUSINESS_ADDRESS_LINE_2=
BUSINESS_CITY=
BUSINESS_STATE=Kerala
BUSINESS_PINCODE=
BUSINESS_PHONE=
BUSINESS_EMAIL=
