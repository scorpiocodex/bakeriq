# === Application ===
PROJECT_NAME=BakeriQ
ENVIRONMENT=development
DEBUG=true

# === Security ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-output-of-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# === Ollama (local LLM) ===
# Ollama runs natively on the host (not in Docker — Intel Arc accel
# is more reliable native, and we keep the worker container slim).
# 172.17.0.1 is the Docker bridge gateway IP; this is how containers
# reach the host. Override to host.docker.internal if your Docker
# version supports it (not all do — bridge IP is the reliable form).
OLLAMA_BASE_URL=http://172.17.0.1:11434

# Pinned model. Llama 3.2 3B Instruct, Q4_K_M quantization (Ollama
# default). ~2GB on disk, ~4GB resident. ~3-5s/inference on Ultra 5
# 125H CPU. Native structured-JSON support via Ollama's `format`
# parameter. To switch models later (e.g. Qwen 2.5 3B), `ollama pull`
# the new one and change this string.
OLLAMA_MODEL=llama3.2:3b

# === Celery ===
# Redis databases 1 and 2 — separate from cache (DB 0) so a celery
# flush doesn't nuke conversation state.
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Twilio — get from https://console.twilio.com (Account SID + Auth Token)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public URL Twilio uses to reach this app. In dev, this is your ngrok URL.
PUBLIC_BASE_URL=http://localhost:8000

# Customer web app dev — points at the api in dev.
# In production this isn't used (frontend-customer build assumes
# same-origin /api/* routing through the reverse proxy).
VITE_API_BASE_URL=http://localhost:8000

# === Database ===
POSTGRES_USER=bakeriq
POSTGRES_PASSWORD=bakeriq_dev_password
POSTGRES_DB=bakeriq
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === CORS ===
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# === Docker user mapping (WSL fix) ===
UID=1000
GID=1000


# === Business details ===
# Printed on invoice headers. Lives here because there's no settings
# table yet — a future Settings → Bakery info section will replace it.
BUSINESS_NAME=BakeriQ
BUSINESS_ADDRESS_LINE_1=
BUSINESS_ADDRESS_LINE_2=
BUSINESS_CITY=
BUSINESS_STATE=Kerala
BUSINESS_PINCODE=
BUSINESS_PHONE=
BUSINESS_EMAIL=
