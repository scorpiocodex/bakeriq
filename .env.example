# === Application ===
PROJECT_NAME=BakeriQ
ENVIRONMENT=development
DEBUG=true

# === Security ===
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-output-of-secrets-token-urlsafe-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080


# Twilio — get from https://console.twilio.com (Account SID + Auth Token)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public URL Twilio uses to reach this app. In dev, this is your ngrok URL.
PUBLIC_BASE_URL=http://localhost:8000


# === Database ===
POSTGRES_USER=bakeriq
POSTGRES_PASSWORD=bakeriq_dev_password
POSTGRES_DB=bakeriq
POSTGRES_HOST=db
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === CORS ===
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# === Docker user mapping (WSL fix) ===
UID=1000
GID=1000
